{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "empatheticbot-com",
  "main": "./worker/contact.mjs",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://empatheticbot.com,https://empatheticbot-com.empatheticbot.workers.dev",
    "CONTACT_FROM": "inquiry@forms.empatheticbot.com",
    "CONTACT_RECIPIENT": "inquiry@empatheticbot.com"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "inquiry@empatheticbot.com"
    }
  ],
  "env": {
    "test": {
      "name": "empatheticbot-com-test",
      "workers_dev": true,
      "secrets": {
        "required": ["TURNSTILE_SECRET_KEY"]
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://empatheticbot-com-test.empatheticbot.workers.dev",
        "CONTACT_FROM": "inquiry@forms.empatheticbot.com",
        "CONTACT_RECIPIENT": "inquiry@empatheticbot.com",
        "TURNSTILE_TEST_MODE": "true"
      },
      "send_email": [
        {
          "name": "CONTACT_EMAIL",
          "destination_address": "inquiry@empatheticbot.com"
        }
      ]
    }
  }
}
